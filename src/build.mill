//| mill-version: 1.1.6
//| mvnDeps:
//| - com.typesafe:config:1.4.3
import mill._
import mill.scalalib._
import mill.api.BuildCtx

trait SpinalModule extends ScalaModule {
  def scalaVersion = "2.13.14"
  def simSource = Task.Source(moduleDir / "sim")
  def sources = Task { super.sources() :+ simSource() }
  
  override def mvnDeps = Seq(
    mvn"com.github.spinalhdl::spinalhdl-core:1.12.3",
    mvn"com.github.spinalhdl::spinalhdl-lib:1.12.3"
  )

  override def scalacPluginMvnDeps = Seq(mvn"com.github.spinalhdl::spinalhdl-idsl-plugin:1.12.3")

  val sim_name = "SpreadSpectrumTopAnalog"
  val projectRoot = BuildCtx.workspaceRoot / os.up
  val scriptDir   = projectRoot / "scripts"
  val pnrDir      = moduleDir / "pnr"
  val quartusDir  = projectRoot / "quartus"

  def pinsFile: T[PathRef]       = Task.Source(quartusDir / "pins" / "de1_pin_assignments_minimumio.tcl")
  def sdcFile: T[PathRef]        = Task.Source(quartusDir / "timings.sdc")
  def qprojectScript: T[PathRef] = Task.Source(scriptDir / "create_quartus_project_settings.tcl")

  def generateVhdl: T[PathRef] = Task {
    val name       = moduleDir.last.toString
    val mainClass  = s"$name.genvhdl"
    val outputName = s"$name.vhd"
    val targetDir = projectRoot / "src" / "sim_output" / sim_name / "rtl" 
    val workDir    = moduleDir / os.up
    val outputFile = targetDir / outputName
    val classpath  = runClasspath().map(_.path).mkString(java.io.File.pathSeparator)

    os.proc("java",
      s"-DspinalTargetDir=$targetDir",
      "-cp", classpath,
      mainClass
    ).call(
      cwd    = workDir,
      stdout = os.Inherit,
      stderr = os.Inherit
    )

    PathRef(outputFile)
  }

  def generateVerilog(topLevel: String = sim_name) = Task.Command {
    val name       = moduleDir.last.toString
    val mainClass  = s"$name.genverilog"
    val outputName = s"$name.v"
    val targetDir = projectRoot / "src" / "sim_output" / topLevel / "rtl" 
    val workDir    = moduleDir / os.up
    val outputFile = targetDir / outputName
    val classpath  = runClasspath().map(_.path).mkString(java.io.File.pathSeparator)

    os.proc("java",
      s"-DspinalTargetDir=$targetDir",
      "-cp", classpath,
      mainClass,
      topLevel
    ).call(
      cwd    = workDir,
      stdout = os.Inherit,
      stderr = os.Inherit
    )

    PathRef(outputFile)
  }

  def qproject: T[PathRef] = Task {
    val name   = moduleDir.last
    val vhdl   = generateVhdl()
    val pins   = pinsFile()
    val sdc    = sdcFile()
    val script = qprojectScript()

    if (!os.exists(sdc.path))
      throw new Exception(s"SDC file missing! Expected at: ${sdc.path}")
    if (!os.exists(pins.path))
      throw new Exception(s"Pins file missing! Expected at: ${pins.path}")

    println(s"Starting Quartus project generation for: $name")

    os.proc("quartus_sh",
      "--64bit",
      "-t", script.path,
      "-projectname", name,
      "-vhdlfile",    vhdl.path,
      "-pinfile",     pins.path,
      "-sdcfile",     sdc.path
    ).call(
      cwd    = Task.dest,
      stdout = os.Inherit,
      stderr = os.Inherit
    )

    PathRef(Task.dest)
  }

  def quartusgui() = Task.Command {
    val name       = moduleDir.last
    val projectDir = quartusDir
    os.proc("quartus", "--64bit", projectDir / "spread_quartus.qpf")
      .call(cwd = projectDir, stdout = os.Inherit, stderr = os.Inherit)
  }

  def prog(topLevel: String = sim_name) = Task.Command {
    val sof = synthesis(topLevel)().path 
    
    os.proc("quartus_pgm",
      "--64bit",
      "-c", "USB-Blaster",
      "--mode", "jtag",
      s"--operation=p;$sof"
    ).call(stdout = os.Inherit, stderr = os.Inherit)
  }

  def synthesis(topLevel: String = sim_name) = Task.Command {    
    val name       = moduleDir.last
    val projectDir = quartusDir

    val vFile = s"../src/sim_output/$topLevel/rtl/$topLevel.v"

    println(s"Setting TOP_LEVEL to '$topLevel' via set_files.tcl...")
    
    os.proc("quartus_sh", "-t", projectDir / "set_files.tcl", topLevel, vFile)
      .call(cwd = projectDir, stdout = os.Inherit, stderr = os.Inherit)

    os.proc("quartus_sh", "--64bit", "--flow", "compile", quartusDir / "spread_quartus.qpf")
      .call(cwd = projectDir, stdout = os.Inherit, stderr = os.Inherit)

    val fitSummary = quartusDir / "output_files" / "spread_quartus.fit.summary"
    val mapSummary = quartusDir / "output_files" / "spread_quartus.map.summary"
    println("\n")
    println("-----------")
    if (os.exists(mapSummary)) println(os.read(mapSummary))
    println("\n")
    println("-----------")
    if (os.exists(fitSummary)) println(os.read(fitSummary))
    println("-----------")    
    
    PathRef(quartusDir / "output_files/spread_quartus.sof")
  }

  def sim: T[PathRef] = Task {
    val name = moduleDir.last
    val mainClass = s"$name.TopLevelSimAnalog"
    val simDir = projectRoot / "src" / "sim_output"
    val targetDir =  simDir / "simFiles"
    val cp = runClasspath().map(_.path).mkString(java.io.File.pathSeparator)

    os.proc(
      "java", 
      s"-DspinalSimWorkspace=$targetDir", 
      "-cp", cp, 
      mainClass
    ).call(cwd = projectRoot / "src", stdout = os.Inherit, stderr = os.Inherit)

    PathRef(Task.dest)
  }

  def simwave() = Task.Command {
    val simDir = projectRoot / "src" / "sim_output"
    val wave = simDir / sim_name / "test" / "wave.fst"
    os.proc("gtkwave", wave)
      .call(stdout = os.Inherit, stderr = os.Inherit)
  }

  def tbFile: T[PathRef] = Task.Source(moduleDir / "sim" / s"${moduleDir.last}_tb.vhd")

  def ghdlsim: T[PathRef] = Task {
    val name = moduleDir.last 
    val vhd  = generateVhdl().path
    val tb   = tbFile().path
    os.proc("ghdl", "-a", "--std=08", vhd, tb)
      .call(cwd = Task.dest, stdout = os.Inherit, stderr = os.Inherit)
    os.proc("ghdl", "-e", "--std=08", s"${name}_tb")
      .call(cwd = Task.dest, stdout = os.Inherit, stderr = os.Inherit)
    os.proc("ghdl", "-r", "--std=08", s"${name}_tb", "--vcd=wave.fst")
      .call(cwd = Task.dest, stdout = os.Inherit, stderr = os.Inherit)
    PathRef(Task.dest / "wave.fst")
  }

  def ghdlsimwave() = Task.Command {
    val wave = ghdlsim().path
    os.proc("gtkwave", wave)
      .call(stdout = os.Inherit, stderr = os.Inherit)
  }
}

